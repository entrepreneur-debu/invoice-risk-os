# =============================================================================
# Invoice Risk & Payment Control OS - local development environment
#
#   cp .env.example .env
#
# Every value below is a DEVELOPMENT PLACEHOLDER. None of them is a real credential.
# Never commit .env. Production values come from a secret manager, not this file.
#
# URLs here point at localhost so the backend can run directly on your machine
# (see README "Running without Docker"). docker-compose.yml overrides the hostnames
# with the internal service names (postgres, redis, minio, api) for containers.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | production. Production refuses placeholder secrets,
# wildcard CORS and diagnostics endpoints, and disables /docs.
APP_ENV=development
# Signing secret for future sessions/tokens. Production requires >= 32 random chars
# (e.g. `openssl rand -hex 32`).
APP_SECRET_KEY=dev-only-insecure-secret-change-me
LOG_LEVEL=INFO

# --- HTTP / security ---------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Maximum accepted request body size in bytes (1 MiB). Raised per-route later for uploads.
MAX_REQUEST_BODY_BYTES=1048576
# Exposes POST /api/v1/diagnostics/worker-ping. Must be false in production.
ENABLE_DIAGNOSTICS_ENDPOINTS=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=invoice_risk
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=invoice_risk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://invoice_risk:local-dev-password@localhost:5432/invoice_risk

# --- Redis / Celery ----------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Optional; both default to REDIS_URL when empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Object storage (MinIO locally; any S3-compatible API elsewhere) ----------
MINIO_ROOT_USER=local-dev-minio
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-dev-minio
S3_SECRET_ACCESS_KEY=local-dev-minio-password
S3_BUCKET=invoice-risk-documents
# Create the bucket on startup if missing (local development convenience only).
S3_AUTO_CREATE_BUCKET=true

# --- AI provider -------------------------------------------------------------
# mock | gemini | anthropic. `mock` makes no network calls (automated tests always
# use it). `gemini` requires GEMINI_API_KEY. `anthropic` is not implemented yet.
AI_PROVIDER=mock
# Google Gemini API key (https://aistudio.google.com/apikey). Put the real key ONLY
# in your local .env, never in this file.
GEMINI_API_KEY=
# Gemini model ID used when AI_PROVIDER=gemini.
GEMINI_MODEL=gemini-2.5-flash
# Per-request timeout for AI provider calls, in seconds.
AI_REQUEST_TIMEOUT_SECONDS=60
# Leave empty. Reserved for a later step.
ANTHROPIC_API_KEY=

# --- Service URLs --------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
# Public URL of the web app (used for docs/CORS alignment).
FRONTEND_URL=http://localhost:3000
# Public URL of the API.
BACKEND_URL=http://localhost:8000
# URL the Next.js server uses to reach the API (server-side only, never sent to browsers).
API_INTERNAL_URL=http://localhost:8000
