# =============================================================================
# Invoice Risk & Payment Control OS - environment configuration
#
#   cp .env.example .env
#
# Every value below is a DEVELOPMENT PLACEHOLDER. None of them is a real credential.
# Never commit .env. In production these values come from Secret Manager / the
# platform, never from a file (see docs/deployment-gcp.md).
#
# URLs here point at localhost so the backend can run directly on your machine.
# docker-compose.yml overrides hostnames with service names (postgres, redis, minio, api).
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | production. Production refuses placeholder secrets, insecure
# cookies, wildcard CORS, HTTP URL imports and diagnostics endpoints, and hides /docs.
APP_ENV=development
LOG_LEVEL=INFO
# Public URL of the web app. Used to build invitation links.
APP_BASE_URL=http://localhost:3000

# --- Authentication ------------------------------------------------------------
# Secret for hashing session/invitation tokens and CSRF tokens.
# Production: >= 32 random characters, e.g. `openssl rand -hex 32`.
AUTH_SECRET=dev-only-insecure-secret-change-me
# Absolute session lifetime and inactivity timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
# Secure (HTTPS-only) cookies. Must be true in production; false for http://localhost.
SESSION_COOKIE_SECURE=false
INVITATION_TTL_HOURS=72
# Brute-force protection (per rate-limit window).
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_MAX_ATTEMPTS_PER_EMAIL=10
SIGNUP_MAX_PER_IP=10
RATE_LIMIT_WINDOW_SECONDS=900

# --- Data protection -----------------------------------------------------------
# base64 of exactly 32 random bytes; encrypts vendor bank account numbers at rest.
# Production: `openssl rand -base64 32`. Changing it makes stored account numbers
# unreadable, so treat it like a database key. (Placeholder decodes to a dev string.)
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtZGF0YS1rZXktMDAwMDA=

# --- HTTP / security ---------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly. The web app
# proxies API calls same-origin, so this is only needed for other clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Maximum JSON request body (1 MiB); upload and inbound-email limits are separate.
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=15728640
MAX_INBOUND_EMAIL_BYTES=26214400
# Exposes POST /api/v1/diagnostics/worker-ping. Must be false in production.
ENABLE_DIAGNOSTICS_ENDPOINTS=true

# --- Invoice URL import (SSRF-protected) ---------------------------------------
URL_IMPORT_ENABLED=true
# Allow plain http:// URLs (never in production).
URL_IMPORT_ALLOW_HTTP=false
URL_IMPORT_ALLOWED_PORTS=443,80
URL_IMPORT_MAX_REDIRECTS=3
URL_IMPORT_TIMEOUT_SECONDS=15

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=invoice_risk
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=invoice_risk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://invoice_risk:local-dev-password@localhost:5432/invoice_risk

# --- Redis / Celery ----------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Optional overrides for host-run processes; both default to REDIS_URL when empty.
# (Compose containers always use the compose Redis.)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Maximum automatic retries for transient background-task failures.
TASK_MAX_RETRIES=3

# --- Object storage ----------------------------------------------------------
# s3  = MinIO locally or any S3-compatible API (needs access keys)
# gcs = Google Cloud Storage via Application Default Credentials (no keys)
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=invoice-risk-documents
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=local-dev-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-dev-minio-password
# Create the bucket at startup if missing (local development convenience only).
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# MinIO server credentials (compose only). Keep equal to the access keys above.
MINIO_ROOT_USER=local-dev-minio
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AI (Gemini) -------------------------------------------------------------
# mock   = deterministic, offline (default; tests and CI always use it)
# gemini = Google Gemini API; requires GEMINI_API_KEY
AI_PROVIDER=mock
# Get a key at https://aistudio.google.com/apikey. Put the real key ONLY in .env
# (or Secret Manager in production), never in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Email ingestion -----------------------------------------------------------
# Domain shown for each organization's inbound invoice address.
INBOUND_EMAIL_DOMAIN=inbound.localhost

# --- Google Cloud (optional) -------------------------------------------------
# Set on Google Cloud to correlate logs with Cloud Trace.
GOOGLE_CLOUD_PROJECT=

# --- Ports and URLs used by docker compose and scripts ----------------------------
API_PORT=8000
WEB_PORT=3000
# Used by scripts/smoke-test.sh and the end-to-end tests.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# How the Next.js server reaches the API (server-side only, never sent to browsers).
API_INTERNAL_URL=http://localhost:8000
# Google Cloud only: audience (the API's Cloud Run URL) for service identity tokens when
# the API is private (--no-allow-unauthenticated). Leave empty locally.
API_ID_TOKEN_AUDIENCE=
